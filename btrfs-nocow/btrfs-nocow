def build_parser() -> argparse.ArgumentParser:
    """コマンドラインの定義。"""
    presets = "\n".join(f"  {k:<11} {v.description}" for k, v in PRESETS.items())
    p = argparse.ArgumentParser(
        prog="btrfs-nocow",
        description="btrfs で CoW を切るべき場所を洗い出し、サブボリューム化・NOCOW 化して移し替える。",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"プリセット（migrate --preset）:\n{presets}\n\n例:\n"
        "  btrfs-nocow scan\n"
        "  btrfs-nocow migrate --preset docker --dry-run\n"
        "  btrfs-nocow migrate ~/.atuin/data --nocow --no-sudo   # 自分のディレクトリ（書き込むプロセスは先に止める）\n"
        "  btrfs-nocow migrate /srv/vm --subvolume --nocow\n"
        "  btrfs-nocow cleanup",
    )
    p.add_argument("--log", type=Path, help="ログファイル（既定: ~/logs/btrfs-nocow/<日時>-<サブコマンド>.log）")
    sub = p.add_subparsers(dest="command", required=True)

    s = sub.add_parser("scan", help="洗い出しを行い、判定を表にする（root なしでも動く）")
    s.add_argument("--roots", nargs="+", metavar="DIR", help="大きな DB・VM イメージを探す場所（既定: ホーム・/srv・/var/lib・/opt）")
    s.add_argument("--min-size", type=parse_size, default=parse_size("32M"), help="探すファイルの最小の大きさ（既定: 32M）")
    s.add_argument("--no-files", action="store_true", help="大きな DB・VM イメージを探さない")
    s.add_argument("--no-sizes", action="store_true", help="よくある置き場所の容量を数えない")
    s.add_argument("--size-time-limit", type=float, default=10.0, help="容量を数える時間の上限 [秒]（超えたら「≥」付きで出す）")
    s.add_argument("--all", action="store_true", help="無い置き場所や「不要」と判定したファイルも表に出す")
    s.add_argument("--sudo", action="store_true", help="sudo で起動し直して、root しか読めない場所も調べる")

    for name, help_text in (("migrate", "ディレクトリを作り直して移す"), ("rollback", "migrate の前に戻す"), ("cleanup", "退避した <パス>.old を削除する")):
        c = sub.add_parser(name, help=help_text, formatter_class=argparse.RawDescriptionHelpFormatter)
        c.add_argument("paths", nargs="*", metavar="PATH", help="対象のディレクトリ" + ("" if name == "migrate" else "（省略時は記録にあるすべて）"))
        c.add_argument("--dry-run", action="store_true", help="確認だけ行い、何も変更しない")
        c.add_argument("-y", "--yes", action="store_true", help="確認を求めない")
        c.add_argument("--no-sudo", action="store_true", help="sudo で起動し直さない（自分のディレクトリを一般ユーザーのまま扱う）")
        c.add_argument("--state", type=Path, help="移行の記録のファイル（既定: root なら /var/lib/btrfs-nocow/state.json）")
        if name == "migrate":
            c.add_argument("--preset", choices=sorted(PRESETS), help="よく使う組み合わせ（下のプリセットの一覧を参照）")
            c.add_argument("--subvolume", action="store_true", help="サブボリュームとして作り直す（スナップショットから外す）")
            c.add_argument("--nocow", action="store_true", help="全体を NOCOW にする")
            c.add_argument("--nocow-subdir", action="append", default=[], metavar="REL", help="このサブディレクトリだけ NOCOW にする（複数可）")
            c.add_argument("--stop", action="append", default=[], metavar="UNIT", help="移行の間止める systemd のユニット（複数可、指定順に止める）")
            c.epilog = f"プリセット:\n{presets}"
    return p


def default_log_path(command: str) -> Path:
    """既定のログファイル。"""
    stamp = dt.datetime.now().strftime("%Y%m%d-%H%M%S")
    return invoking_user().home / "logs" / "btrfs-nocow" / f"{stamp}-{command}.log"


def reexec_with_sudo(argv: list[str]) -> None:
    """同じ Python（rich が入った環境）のまま、sudo で自分を起動し直す。"""
    script = os.path.abspath(__file__)
    cmd = ["sudo", sys.executable, "-B", script, *argv]
    Console(stderr=True).print(f"[dim]root で実行するため sudo で起動し直します: {shlex.join(['sudo', 'btrfs-nocow', *argv])}[/]")
    os.execvp("sudo", cmd)


def main(argv: list[str] | None = None) -> int:
    """入口。"""
    argv = list(sys.argv[1:] if argv is None else argv)
    args = build_parser().parse_args(argv)
    if os.geteuid() != 0:
        if args.command == "scan" and args.sudo:
            reexec_with_sudo(argv)
        if args.command in ("migrate", "rollback", "cleanup") and not args.no_sudo:
            reexec_with_sudo(argv)
    log.open(args.log or default_log_path(args.command))
    log(f"btrfs-nocow {shlex.join(argv)}（ログ: {log.path}。`tail -f` で経過を追える）", "dim")
    try:
        return {"scan": cmd_scan, "migrate": cmd_migrate, "rollback": cmd_rollback, "cleanup": cmd_cleanup}[args.command](args)
    except MigrationError as e:
        log(f"エラー: {e}", "bold red")
        return 1


if __name__ == "__main__":
    sys.exit(main())
