@dataclass(frozen=True)
class Verdict:
    """判定の結果。"""

    status: str  # 対応済み / 推奨 / 任意 / 不要 / 要 root / 無し
    reason: str
    command: str = ""  # 対処のコマンド例


def judge_location(
    *,
    path: str,
    exists: bool,
    want_subvolume: bool,
    want_nocow: bool,
    nocow_subdirs: tuple[str, ...],
    is_subvol: bool,
    in_snapshot: bool | None,
    nocow: bool | None,
    preset: str | None,
    size: int | None = None,
) -> Verdict:
    """置き場所が望ましい形になっているかを判定する（nocow は全体または対象のサブディレクトリの状態、size は数えられたときの容量）。"""
    if not exists:
        return Verdict("無し", "")
    if size is not None and size < EMPTY_THRESHOLD:
        return Verdict("不要", "中身がほぼ空（使い始める前に移すなら推奨の形にできる）")
    wants_any_nocow = want_nocow or bool(nocow_subdirs)
    if wants_any_nocow and nocow is None:
        return Verdict("要 root", "属性を読めない（sudo で実行すると判定できる）")
    need_subvol = want_subvolume and bool(in_snapshot) and not is_subvol
    need_nocow = wants_any_nocow and nocow is False
    if not need_subvol and not need_nocow:
        return Verdict("対応済み", "")
    reasons = []
    if need_subvol:
        reasons.append("スナップショット対象の中にある")
    if need_nocow:
        reasons.append("NOCOW になっていない")
    if not want_subvolume and need_nocow and in_snapshot:
        reasons.append("スナップショット対象なので NOCOW の効果は限定的")
    if preset:
        cmd = f"btrfs-nocow migrate --preset {preset}"
    else:
        opts = []
        if need_subvol or (want_subvolume and is_subvol):
            opts.append("--subvolume")
        if want_nocow:
            opts.append("--nocow")
        opts += [f"--nocow-subdir {shlex.quote(s)}" for s in nocow_subdirs]
        cmd = f"btrfs-nocow migrate {shlex.quote(path)} {' '.join(opts)}".strip()
    return Verdict("推奨", "・".join(reasons), cmd)


def judge_file(*, kind: str, size: int, extents: int | None, age_days: float, nocow: bool | None, in_snapshot: bool) -> Verdict:
    """大きな DB・VM イメージのファイルを判定する。"""
    if age_days > 30:
        return Verdict("不要", "30 日以上書き換えられていない（チェックサムを残す）")
    if nocow is None:
        return Verdict("要 root", "属性を読めない")
    if nocow:
        if in_snapshot:
            return Verdict("推奨", "NOCOW だがスナップショット対象（親をサブボリュームに）")
        return Verdict("対応済み", "")
    fragmented = extents is not None and extents >= 1000 and extents > size // (1 << 20)
    if kind == "VM" or fragmented:
        reason = f"{extents:,} エクステントに断片化" if fragmented and extents is not None else "VM イメージが CoW のまま"
        return Verdict("推奨", reason)
    return Verdict("不要", "断片化は小さい")


STATUS_STYLE = {"対応済み": "green", "推奨": "bold red", "任意": "yellow", "不要": "dim", "要 root": "magenta", "無し": "dim"}


def libvirt_pool_dirs() -> list[str]:
    """libvirt（qemu:///system）のディレクトリ型プールのパス（virsh が使えなければ空）。"""
    names = query(["virsh", "-c", "qemu:///system", "pool-list", "--all", "--name"]) or ""
    dirs: list[str] = []
    for name in filter(None, (n.strip() for n in names.splitlines())):
        xml = query(["virsh", "-c", "qemu:///system", "pool-dumpxml", name]) or ""
        if re.search(r"<pool type=['\"](dir|fs)['\"]", xml):
            m = re.search(r"<path>(.*?)</path>", xml)
            if m:
                dirs.append(m[1])
    return dirs


def swap_files() -> list[str]:
    """使用中の swap ファイル。"""
    out: list[str] = []
    with contextlib.suppress(OSError):
        for line in Path("/proc/swaps").read_text().splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 2 and parts[1] == "file":
                out.append(_unescape_mountinfo(parts[0]))
    return out


def cmd_scan(args: argparse.Namespace) -> int:
    """洗い出しを行い、判定を表にする。"""
    mounts = read_mounts()
    configs = read_snapshot_configs()
    btrfs_mounts = [m for m in mounts if m.fstype == "btrfs"]
    if not btrfs_mounts:
        log("btrfs のマウントが無い。対象外", "yellow")
        return 0
    if os.geteuid() != 0:
        log("一般ユーザーで実行している。root しか読めない場所は「要 root」になる（sudo で実行すると網羅できる）", "dim")

    # ---- 1. 構成 ----
    t = Table(title="btrfs のマウントとスナップショット", title_justify="left")
    for col in ("マウント先", "サブボリューム", "デバイス", "スナップショット"):
        t.add_column(col)
    for m in btrfs_mounts:
        c = snapshot_config_for(Path(m.mount_point), configs)
        snap = "—" if not c else f"snapper {c.name}" + {True: "（timeline）", False: "", None: ""}[c.timeline]
        t.add_row(m.mount_point, m.root, m.source, snap)
    log.table(t)
    for tool, path in (("timeshift", "/etc/timeshift/timeshift.json"), ("btrbk", "/etc/btrbk/btrbk.conf")):
        if Path(path).exists():
            log(f"{tool} の設定がある（{path}）。このツールが取るスナップショットは上の表に出ないので別途確認する", "yellow")

    # ---- 2. よくある置き場所 ----
    items: list[Known] = list(KNOWN)
    known_paths = {str(expand(k.path)) for k in items}
    for d in libvirt_pool_dirs():
        if str(expand(d)) not in known_paths:
            items.append(Known(d, "libvirt のプール", True, nocow_all=True))
            known_paths.add(str(expand(d)))
    t = Table(title="よくある置き場所", title_justify="left")
    for col in ("判定", "場所", "種類", "容量", "サブボリューム", "スナップショット", "NOCOW", "理由・対処"):
        t.add_column(col, overflow="fold")
    mps = {m.mount_point for m in mounts}
    for k in items:
        p = expand(k.path)
        exists = os.path.isdir(p)
        if not exists:
            if args.all:
                t.add_row(Text("無し", "dim"), str(p), k.label, "", "", "", "", "")
            continue
        m = mount_of(p, mounts)
        if not m or m.fstype != "btrfs":
            continue
        sv = containing_subvolume(p, mounts)
        cfg = snapshot_config_for(sv, configs)
        is_sv = is_subvolume_root(p)
        if k.nocow_subdirs:
            if not os.access(p, os.X_OK):
                nocow = None  # 中を見られない
            else:
                # 対象のサブディレクトリがまだ無ければ、直すものも無い
                flags = [get_nocow(p / s) for s in k.nocow_subdirs if os.path.isdir(p / s)]
                nocow = None if None in flags else all(flags)
        else:
            nocow = get_nocow(p)
        size: str
        measured: int | None = None  # 判定に使う容量（数え切れたときだけ）
        if args.no_sizes:
            size = ""
        elif not os.access(p, os.R_OK | os.X_OK):
            size = "要 root"
        else:
            s = walk_with_status(p, str(p), mount_points=mps, time_limit=args.size_time_limit)
            size = ("≥ " if s.truncated else "") + human(s.bytes)
            measured = None if s.truncated or s.unreadable else s.bytes
        v = judge_location(
            path=str(p), exists=True, want_subvolume=k.want_subvolume, want_nocow=k.nocow_all, nocow_subdirs=k.nocow_subdirs,
            is_subvol=is_sv, in_snapshot=cfg is not None and not is_sv, nocow=nocow, preset=k.preset, size=measured,
        )
        sv_text = "○（根）" if is_sv else f"× {sv} の中"
        nocow_text = {True: "○", False: "×", None: "?"}[nocow] + (f"（{', '.join(k.nocow_subdirs)}）" if k.nocow_subdirs else "")
        detail = "\n".join(x for x in (v.reason, k.note, v.command) if x)
        t.add_row(Text(v.status, STATUS_STYLE[v.status]), str(p), k.label, size, sv_text, cfg.name if cfg and not is_sv else "—", nocow_text, detail)
    log.table(t)

    for sw in swap_files():
        p = Path(sw)
        nocow = get_nocow(p)
        cfg = snapshot_config_for(containing_subvolume(p, mounts), configs)
        if nocow is False or cfg:
            log(f"swap ファイル {sw}: NOCOW={nocow} / スナップショット={cfg.name if cfg else 'なし'}。"
                "btrfs では専用のサブボリュームに `btrfs filesystem mkswapfile` で作る", "red")

    # ---- 3. 大きな DB・VM イメージ ----
    if args.no_files:
        return 0
    roots = [expand(r) for r in args.roots] if args.roots else [p for p in (invoking_user().home, Path("/srv"), Path("/var/lib"), Path("/opt")) if os.path.isdir(p)]
    found: list[tuple[Path, str, os.stat_result]] = []
    unreadable = 0
    other_fs = {m.mount_point for m in mounts if m.fstype != "btrfs"}  # 別のファイルシステムには入らない
    with log.console.status("大きな DB・VM イメージを探しています…") as status:
        n = 0
        for root in roots:
            stack = [str(root)]
            while stack:
                d = stack.pop()
                try:
                    it = os.scandir(d)
                except OSError:
                    unreadable += 1
                    continue
                with it:
                    for e in it:
                        n += 1
                        if n % 5000 == 0:
                            status.update(f"大きな DB・VM イメージを探しています… {n:,} 件（{d[:80]}）")
                        try:
                            if e.is_dir(follow_symlinks=False):
                                if e.name in SCAN_PRUNE_NAMES or e.path in known_paths or e.path in other_fs or e.name.endswith(OLD_SUFFIX):
                                    continue
                                stack.append(e.path)
                                continue
                            if not e.is_file(follow_symlinks=False):
                                continue
                            suffix = Path(e.name).suffix.lower()
                            kind = "VM" if suffix in VM_SUFFIXES else "DB" if suffix in DB_SUFFIXES or e.name in DB_NAMES else ""
                            if not kind:
                                continue
                            s = e.stat(follow_symlinks=False)
                            if s.st_size >= args.min_size:
                                found.append((Path(e.path), kind, s))
                        except OSError:
                            continue
    t = Table(title=f"大きな DB・VM イメージ（{human(args.min_size)} 以上、探した場所: {', '.join(map(str, roots))}）", title_justify="left")
    for col in ("判定", "ファイル", "種類", "大きさ", "エクステント", "最終更新", "NOCOW", "スナップショット", "理由・対処"):
        t.add_column(col, overflow="fold")
    now = time.time()
    compressed = any("compress" in m.super_options for m in btrfs_mounts)
    rows = []
    for p, kind, s in sorted(found, key=lambda x: -x[2].st_size):
        cfg = snapshot_config_for(containing_subvolume(p, mounts), configs)
        nocow = get_nocow(p)
        ext = extent_count(p)
        age = (now - s.st_mtime) / 86400
        v = judge_file(kind=kind, size=s.st_size, extents=ext, age_days=age, nocow=nocow, in_snapshot=cfg is not None)
        cmd = ""
        if v.status == "推奨":
            cmd = f"btrfs-nocow migrate {shlex.quote(str(p.parent))} --nocow" + (" --subvolume" if cfg else "")
        rows.append((v, p, kind, s, ext, age, nocow, cfg, cmd))
    order = {"推奨": 0, "要 root": 1, "任意": 2, "対応済み": 3, "不要": 4}
    hidden = 0 if args.all else sum(1 for r in rows if r[0].status == "不要")
    if not args.all:
        rows = [r for r in rows if r[0].status != "不要"]
    for v, p, kind, s, ext, age, nocow, cfg, cmd in sorted(rows, key=lambda r: order.get(r[0].status, 9)):
        t.add_row(
            Text(v.status, STATUS_STYLE[v.status]), str(p), kind, human(s.st_size), "?" if ext is None else f"{ext:,}",
            f"{age:.0f} 日前" if age >= 1 else "1 日以内", {True: "○", False: "×", None: "?"}[nocow], cfg.name if cfg else "—",
            "\n".join(x for x in (v.reason, cmd) if x),
        )
    log.table(t)
    if hidden:
        log(f"「不要」の {hidden:,} 件は省いた（断片化していない・30 日以上書き換えられていない。--all で表示）", "dim")
    if compressed:
        log("圧縮を有効にしてマウントしている。圧縮されたファイルは 128KiB ごとに数えられるので、エクステント数が多く見える", "dim")
    if unreadable:
        log(f"読めなかったディレクトリ: {unreadable:,} 件（sudo で実行すると網羅できる）", "dim")
    log("対処は「推奨」の行の migrate コマンドで行う（--dry-run で事前確認できる）。親ディレクトリごと作り直すので、"
        "同じ場所に他のデータがあればそれも移る点に注意", "dim")
    return 0


