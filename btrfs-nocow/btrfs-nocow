FS_IOC_GETFLAGS = 0x80086601  # ファイル属性（lsattr で見えるもの）の取得
FS_NOCOW_FL = 0x00800000  # chattr +C
BTRFS_SUBVOL_ROOT_INO = 256  # btrfs のサブボリュームの根のディレクトリの inode 番号

OLD_SUFFIX = ".old"  # 退避先の接尾辞
