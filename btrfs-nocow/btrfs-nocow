class Log:
    """画面（rich）とログファイルの両方に、日時付きで書き出す。"""

    def __init__(self) -> None:
        self.console = Console()
        self.file_console: Console | None = None
        self.path: Path | None = None

    def open(self, path: Path) -> None:
        """ログファイルを開く（親ディレクトリも作る）。sudo 経由なら呼び出したユーザーの所有にする。"""
        missing = [d for d in (path.parent, *path.parent.parents) if not d.exists()]
        path.parent.mkdir(parents=True, exist_ok=True)
        fh = open(path, "a", encoding="utf-8")  # noqa: SIM115 - プロセスの終了まで開いておく
        self.file_console = Console(file=fh, width=220, color_system=None, force_terminal=False, soft_wrap=True)
        self.path = path
        for d in missing:
            give_to_invoking_user(d)
        give_to_invoking_user(path)

    def __call__(self, msg: str, style: str = "") -> None:
        """1行のメッセージ。msg は rich のマークアップとして解釈しない（パスに [ ] が含まれても崩れない）。"""
        ts = dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        line = Text.assemble((f"[{ts}] ", "dim"), (msg, style))
        self.console.print(line)
        if self.file_console:
            self.file_console.print(f"[{ts}] {msg}", markup=False, highlight=False)

    def table(self, table: Table) -> None:
        """表を画面とログファイルに出す。"""
        self.console.print(table)
        if self.file_console:
            self.file_console.print(table)

    def plain(self, msg: str) -> None:
        """日時なしの行（コマンドの出力の転記など）。"""
        self.console.print(msg, markup=False, highlight=False)
        if self.file_console:
            self.file_console.print(msg, markup=False, highlight=False)


log = Log()


