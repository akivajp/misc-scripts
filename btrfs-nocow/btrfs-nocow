@dataclass(frozen=True)
class Mount:
    """/proc/self/mountinfo の1行。"""

    mount_point: str
    root: str  # btrfs ならマウントしているサブボリュームのパス（例: /@home）
    fstype: str
    source: str
    super_options: str


def _unescape_mountinfo(s: str) -> str:
    """mountinfo の 8 進エスケープ（空白は \\040）を戻す。"""
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), s)


def parse_mountinfo(text: str) -> list[Mount]:
    """mountinfo の本文を Mount のリストにする。"""
    mounts: list[Mount] = []
    for line in text.splitlines():
        left, sep, right = line.partition(" - ")
        if not sep:
            continue
        lf, rf = left.split(), right.split()
        if len(lf) < 5 or len(rf) < 2:
            continue
        mounts.append(
            Mount(
                mount_point=_unescape_mountinfo(lf[4]),
                root=_unescape_mountinfo(lf[3]),
                fstype=rf[0],
                source=_unescape_mountinfo(rf[1]),
                super_options=rf[2] if len(rf) > 2 else "",
            )
        )
    return mounts


def read_mounts() -> list[Mount]:
    """現在のマウントの一覧。"""
    return parse_mountinfo(Path("/proc/self/mountinfo").read_text())


def is_under(path: str, parent: str) -> bool:
    """path が parent 自身かその下にあるか（文字列で判定）。"""
    parent = parent.rstrip("/") or "/"
    return path == parent or path.startswith(parent if parent == "/" else parent + "/")


def mount_of(path: Path, mounts: list[Mount]) -> Mount | None:
    """path を含むマウント（最も深いもの）。"""
    best: Mount | None = None
    for m in mounts:
        if is_under(str(path), m.mount_point) and (best is None or len(m.mount_point) >= len(best.mount_point)):
            best = m
    return best


def is_subvolume_root(path: Path) -> bool:
    """btrfs のサブボリュームの根か（root なしでも判定できる）。"""
    try:
        return os.lstat(path).st_ino == BTRFS_SUBVOL_ROOT_INO and stat.S_ISDIR(os.lstat(path).st_mode)
    except OSError:
        return False


def containing_subvolume(path: Path, mounts: list[Mount]) -> Path:
    """path を含むサブボリュームの根（path 自身が根ならそれ）。マウントの境界は越えない。"""
    m = mount_of(path, mounts)
    stop = Path(m.mount_point) if m else Path("/")
    p = path
    while True:
        if is_subvolume_root(p) or p == stop or p.parent == p:
            return p
        p = p.parent


def get_nocow(path: Path) -> bool | None:
    """NOCOW（chattr +C）が付いているか。読めなければ None。通常ファイルとディレクトリ以外には使わないこと。"""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_NOCTTY)
    except OSError:
        return None
    try:
        buf = array.array("i", [0])
        fcntl.ioctl(fd, FS_IOC_GETFLAGS, buf, True)
        return bool(buf[0] & FS_NOCOW_FL)
    except OSError:
        return None
    finally:
        os.close(fd)


def extent_count(path: Path) -> int | None:
    """filefrag によるエクステント数（断片化の目安）。"""
    out = query(["filefrag", str(path)])
    m = re.search(r"(\d+) extents? found", out or "")
    return int(m[1]) if m else None


# ---- snapper ----


@dataclass(frozen=True)
class SnapshotConfig:
    """スナップショットを取っている設定（snapper の config）。"""

    name: str
    subvolume: str
    timeline: bool | None  # None は不明（設定ファイルを読めなかった）


def parse_snapper_config(text: str) -> dict[str, str]:
    """snapper の設定ファイル（KEY="value" 形式）を辞書にする。"""
    out: dict[str, str] = {}
    for line in text.splitlines():
        m = re.match(r'^\s*([A-Z_]+)="(.*)"\s*$', line)
        if m:
            out[m[1]] = m[2]
    return out


def read_snapshot_configs() -> list[SnapshotConfig]:
    """snapper の設定の一覧。設定ファイルが読めなければ `snapper list-configs` で補う。"""
    configs: list[SnapshotConfig] = []
    cfg_dir = Path("/etc/snapper/configs")
    unreadable = False
    if os.path.isdir(cfg_dir):
        for f in sorted(cfg_dir.iterdir()):
            try:
                kv = parse_snapper_config(f.read_text())
            except OSError:
                unreadable = True
                continue
            if "SUBVOLUME" in kv:
                configs.append(SnapshotConfig(f.name, kv["SUBVOLUME"], kv.get("TIMELINE_CREATE", "no") == "yes"))
    if unreadable:
        out = query(["snapper", "--csvout", "--no-headers", "list-configs"]) or ""
        known = {c.name for c in configs}
        for line in out.splitlines():
            name, _, subvol = line.partition(",")
            if name and subvol and name not in known:
                configs.append(SnapshotConfig(name, subvol, None))
    return configs


def snapshot_config_for(subvol_root: Path, configs: list[SnapshotConfig]) -> SnapshotConfig | None:
    """サブボリュームの根をスナップショットしている設定。"""
    for c in configs:
        if os.path.realpath(c.subvolume) == os.path.realpath(subvol_root):
            return c
    return None


# ---- ディレクトリの中身の集計 ----


@dataclass
class TreeStats:
    """ディレクトリの下の集計（根自身は数えない）。"""

    entries: int = 0  # ファイル・ディレクトリ・リンク等の数
    files: int = 0  # 通常ファイルの数
    bytes: int = 0  # 通常ファイルの大きさの合計（見かけの大きさ）
    not_nocow: int = 0  # check_nocow のとき、NOCOW でない通常ファイル・ディレクトリの数
    nested_subvolumes: list[str] = field(default_factory=list)
    mounts: list[str] = field(default_factory=list)
    unreadable: int = 0
    truncated: bool = False  # time_limit で打ち切った


def walk_tree(
    root: Path,
    *,
    check_nocow: bool = False,
    mount_points: set[str] | None = None,
    time_limit: float | None = None,
    on_progress: Callable[[TreeStats], None] | None = None,
) -> TreeStats:
    """root の下を数える。別のマウントと入れ子のサブボリュームには入らない（数だけ記録する）。"""
    st = TreeStats()
    root_dev = os.lstat(root).st_dev
    mps = mount_points if mount_points is not None else {m.mount_point for m in read_mounts()}
    stack = [str(root)]
    start = last = time.monotonic()
    while stack:
        d = stack.pop()
        try:
            it = os.scandir(d)
        except OSError:
            st.unreadable += 1
            continue
        with it:
            for e in it:
                st.entries += 1
                try:
                    s = e.stat(follow_symlinks=False)
                except OSError:
                    st.unreadable += 1
                    continue
                if stat.S_ISDIR(s.st_mode):
                    if e.path in mps:
                        st.mounts.append(e.path)
                        continue
                    if s.st_dev != root_dev:  # btrfs の入れ子のサブボリュームは st_dev が変わる
                        st.nested_subvolumes.append(e.path)
                        continue
                    if check_nocow and get_nocow(Path(e.path)) is False:
                        st.not_nocow += 1
                    stack.append(e.path)
                elif stat.S_ISREG(s.st_mode):
                    st.files += 1
                    st.bytes += s.st_size
                    if check_nocow and get_nocow(Path(e.path)) is False:
                        st.not_nocow += 1
        now = time.monotonic()
        if on_progress and now - last > 0.2:
            on_progress(st)
            last = now
        if time_limit is not None and now - start > time_limit:
            st.truncated = True
            break
    return st


# 注意: ディレクトリの判定は Path.is_dir ではなく os.path.isdir を使う。
# Path.is_dir は Python の版によって、root しか開けない場所で PermissionError を投げるため。


def walk_with_status(root: Path, label: str, **kwargs: Any) -> TreeStats:
    """walk_tree を、件数の出るスピナー付きで実行する。"""
    with log.console.status(f"{label}: 数えています…") as status:

        def show(s: TreeStats) -> None:
            status.update(f"{label}: {s.entries:,} 件 / {human(s.bytes)}")

        return walk_tree(root, on_progress=show, **kwargs)


