def human(n: int | float | None) -> str:
    """バイト数を KiB / MiB / GiB の表記にする。"""
    if n is None:
        return "?"
    value = float(n)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(value) < 1024 or unit == "TiB":
            return f"{int(value)} B" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024
    return f"{value:.1f} TiB"


def parse_size(s: str) -> int:
    """'32M' や '1G' をバイト数にする（2 の累乗の単位）。"""
    m = re.fullmatch(r"\s*(\d+(?:\.\d+)?)\s*([KMGT]?)i?B?\s*", s, re.IGNORECASE)
    if not m:
        raise argparse.ArgumentTypeError(f"大きさの形式が不正: {s}（例: 32M, 1G）")
    mult = {"": 1, "K": 1 << 10, "M": 1 << 20, "G": 1 << 30, "T": 1 << 40}[m[2].upper()]
    return int(float(m[1]) * mult)


@dataclass(frozen=True)
class InvokingUser:
    """sudo で起動し直していても、元のユーザーを指す。"""

    name: str
    uid: int
    gid: int
    home: Path


def invoking_user() -> InvokingUser:
    """呼び出したユーザー（sudo なら SUDO_USER、そうでなければ自分）。"""
    name = os.environ.get("SUDO_USER") if os.geteuid() == 0 else None
    pw = pwd.getpwnam(name) if name else pwd.getpwuid(os.getuid())
    return InvokingUser(pw.pw_name, pw.pw_uid, pw.pw_gid, Path(pw.pw_dir))


def give_to_invoking_user(path: Path) -> None:
    """root で作ったログ等を、sudo を呼んだユーザーの所有にする（後で一般ユーザーが読み書きできるように）。"""
    if os.geteuid() == 0 and os.environ.get("SUDO_USER"):
        u = invoking_user()
        with contextlib.suppress(OSError):
            os.chown(path, u.uid, u.gid)


def expand(path: str) -> Path:
    """'~' を呼び出したユーザーのホームに展開し、絶対パスにする（シンボリックリンクは解決しない）。"""
    if path == "~" or path.startswith("~/"):
        path = str(invoking_user().home) + path[1:]
    return Path(os.path.abspath(path))


def run(cmd: list[str], *, check: bool = True, quiet: bool = False) -> subprocess.CompletedProcess[str]:
    """変更を伴うコマンドを、内容をログに残してから実行する。"""
    if not quiet:
        log(f"+ {shlex.join(cmd)}", "yellow")
    res = subprocess.run(cmd, capture_output=True, text=True, env=CMD_ENV)
    for line in (res.stdout + res.stderr).splitlines():
        if line.strip() and not quiet:
            log.plain(f"    {line}")
    if check and res.returncode != 0:
        raise MigrationError(f"コマンドが失敗した（終了コード {res.returncode}）: {shlex.join(cmd)}\n{res.stderr.strip()}")
    return res


def query(cmd: list[str]) -> str | None:
    """読み取りだけのコマンドの標準出力（失敗・未導入なら None）。"""
    if not shutil.which(cmd[0]):
        return None
    try:
        res = subprocess.run(cmd, capture_output=True, text=True, env=CMD_ENV, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return res.stdout if res.returncode == 0 else None


