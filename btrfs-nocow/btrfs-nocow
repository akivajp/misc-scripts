def old_path(path: Path) -> Path:
    """退避先のパス。"""
    return path.with_name(path.name + OLD_SUFFIX)


# ---- 記録（state.json） ----


def default_state_path() -> Path:
    """移行の記録の置き場所。"""
    if os.geteuid() == 0:
        return Path("/var/lib/btrfs-nocow/state.json")
    base = os.environ.get("XDG_STATE_HOME") or str(Path.home() / ".local" / "state")
    return Path(base) / "btrfs-nocow" / "state.json"


class State:
    """移行の記録。rollback / cleanup が参照する。"""

    def __init__(self, path: Path) -> None:
        self.path = path
        self.data: dict[str, Any] = {"migrations": {}}
        if path.exists():
            self.data = json.loads(path.read_text())

    @property
    def migrations(self) -> dict[str, dict[str, Any]]:
        """パス → 記録。"""
        return self.data.setdefault("migrations", {})

    def save(self) -> None:
        """書き込む（途中で落ちても壊れないよう、別名に書いてから置き換える）。"""
        self.path.parent.mkdir(parents=True, exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=self.path.parent, prefix=".state-")
        with os.fdopen(fd, "w") as f:
            json.dump(self.data, f, ensure_ascii=False, indent=2)
        os.replace(tmp, self.path)


@contextlib.contextmanager
def state_lock(state_path: Path) -> Iterator[None]:
    """同時に2つの移行が走らないようにする。"""
    state_path.parent.mkdir(parents=True, exist_ok=True)
    with open(state_path.parent / ".lock", "w") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise MigrationError(f"別の btrfs-nocow が実行中（{state_path.parent / '.lock'}）") from None
        yield


# ---- サービスの停止と再開 ----


def unit_state(unit: str) -> tuple[bool, bool]:
    """(存在するか, 動いているか)。"""
    out = query(["systemctl", "show", "-p", "LoadState", "-p", "ActiveState", unit]) or ""
    kv = dict(line.split("=", 1) for line in out.splitlines() if "=" in line)
    return kv.get("LoadState") == "loaded", kv.get("ActiveState") in ("active", "activating", "reloading")


def stop_units(units: list[str], stopped: list[str]) -> None:
    """動いているものを指定の順に止め、止めたものを stopped に足す（途中で失敗しても、そこまでに止めたものが残る）。

    docker.socket のように、止めると他のユニット（docker.service）も一緒に止まるものがある。
    そのため、動いているかどうかは止め始める前にまとめて調べ、一緒に止まったものも再開の対象に入れる。
    """
    active_before: list[str] = []
    for u in units:
        exists, active = unit_state(u)
        if not exists:
            log(f"{u}: 無いのでスキップ", "dim")
        elif not active:
            log(f"{u}: 動いていない", "dim")
        else:
            active_before.append(u)
    for u in active_before:
        if unit_state(u)[1]:
            run(["systemctl", "stop", u])
        else:
            log(f"{u}: 先に止めたユニットと一緒に止まった", "dim")
        stopped.append(u)
    for u in stopped:
        if unit_state(u)[1]:
            raise MigrationError(f"{u} が止まらない")


def start_units(stopped: list[str]) -> None:
    """止めたものを逆順に起動する（失敗しても残りは続ける）。"""
    for u in reversed(stopped):
        with contextlib.suppress(MigrationError):
            run(["systemctl", "start", u], check=False)
        if not unit_state(u)[1]:
            log(f"{u} が起動していない。`systemctl status {u}` で確認する", "bold red")


def docker_running_containers() -> list[str]:
    """動いている Docker のコンテナ名。"""
    out = query(["docker", "ps", "--format", "{{.Names}}"])
    return [n for n in (out or "").splitlines() if n.strip()]


def restore_docker_containers(names: list[str]) -> None:
    """移行前に動いていたコンテナのうち、止まっているものを起動する（再起動ポリシーが no のもの等）。"""
    if not names or not shutil.which("docker"):
        return
    for _ in range(60):
        if query(["docker", "info", "--format", "{{.ServerVersion}}"]):
            break
        time.sleep(1)
    time.sleep(5)  # 再起動ポリシーで上がるものを待つ
    running = set(docker_running_containers())
    for n in names:
        if n not in running:
            run(["docker", "start", n], check=False)
    time.sleep(5)
    out = query(["docker", "ps", "--format", "{{.Names}}\t{{.Status}}"]) or ""
    for line in out.splitlines():
        log.plain(f"    {line}")
    missing = set(names) - set(docker_running_containers())
    if missing:
        log(f"起動していないコンテナ: {', '.join(sorted(missing))}", "bold red")


# ---- 開いているプロセスの確認 ----


def processes_using(paths: list[Path]) -> list[str]:
    """paths の下のファイルを開いている（cwd・mmap を含む）プロセス。"""
    prefixes = [str(p) for p in paths]
    me = os.getpid()
    found: list[str] = []
    for name in os.listdir("/proc"):
        if not name.isdigit() or int(name) == me:
            continue
        base = f"/proc/{name}"
        try:
            comm = Path(f"{base}/comm").read_text().strip()
        except OSError:
            continue
        targets: list[str] = []
        for link in ("cwd", "exe"):
            with contextlib.suppress(OSError):
                targets.append(os.readlink(f"{base}/{link}"))
        with contextlib.suppress(OSError):
            for fd in os.listdir(f"{base}/fd"):
                with contextlib.suppress(OSError):
                    targets.append(os.readlink(f"{base}/fd/{fd}"))
        with contextlib.suppress(OSError), open(f"{base}/maps") as f:
            for line in f:
                parts = line.split(None, 5)
                if len(parts) == 6:
                    targets.append(parts[5].strip())
        for t in targets:
            t = t.removesuffix(" (deleted)")
            if any(is_under(t, p) for p in prefixes):
                found.append(f"PID {name}（{comm}）: {t}")
                break
    return found


def processes_named(prefixes: tuple[str, ...]) -> list[str]:
    """名前（comm）が接頭辞に一致するプロセス。"""
    out: list[str] = []
    for name in os.listdir("/proc"):
        if name.isdigit():
            with contextlib.suppress(OSError):
                comm = Path(f"/proc/{name}/comm").read_text().strip()
                if comm.startswith(prefixes):
                    out.append(f"PID {name}（{comm}）")
    return out


# ---- 1か所の計画 ----


@dataclass
class Plan:
    """1か所の移行の計画。"""

    path: Path
    subvolume: bool
    nocow_all: bool
    nocow_subdirs: list[str]
    skip: str = ""  # 空でなければ移行しない理由（対応済み等）
    errors: list[str] = field(default_factory=list)
    warnings: list[str] = field(default_factory=list)
    stats: TreeStats | None = None
    nocow_bytes: int = 0  # 実コピーになる容量
    snapshot: str = ""

    @property
    def old(self) -> Path:
        """退避先。"""
        return old_path(self.path)

    def describe(self) -> str:
        """操作の要約。"""
        ops = ["サブボリュームとして作り直す" if self.subvolume else "ディレクトリとして作り直す"]
        if self.nocow_all:
            ops.append("全体を NOCOW")
        if self.nocow_subdirs:
            ops.append("NOCOW: " + ", ".join(self.nocow_subdirs))
        return "・".join(ops)


def nocow_is_satisfied(path: Path, nocow_all: bool, nocow_subdirs: list[str]) -> bool:
    """NOCOW にすべき範囲が、中のファイルまで NOCOW になっているか。"""
    areas = [path] if nocow_all else [path / s for s in nocow_subdirs if os.path.isdir(path / s)]
    for a in areas:
        if get_nocow(a) is not True or walk_tree(a, check_nocow=True).not_nocow:
            return False
    return True


def make_plan(spec: TargetSpec, mounts: list[Mount], configs: list[SnapshotConfig]) -> Plan:
    """事前確認を行い、計画を作る（何も変更しない）。"""
    path = expand(spec.path)
    plan = Plan(path, spec.subvolume, spec.nocow_all, list(spec.nocow_subdirs))
    if os.path.islink(path):
        plan.errors.append("シンボリックリンクは対象外（リンク先を指定する）")
        return plan
    if not os.path.isdir(path):
        plan.errors.append("ディレクトリが無い")
        return plan
    if not os.access(path, os.R_OK | os.X_OK):
        plan.errors.append("中を読めない（root で実行する）")
        return plan
    m = mount_of(path, mounts)
    if not m or m.fstype != "btrfs":
        plan.errors.append("btrfs の上ではない")
        return plan
    if m.mount_point == str(path):
        plan.errors.append("マウントポイントは対象外（既に別にマウントされている。中身だけ移すなら別の方法で）")
        return plan
    if old_path(path).exists():
        plan.errors.append(f"{old_path(path)} が既にある（前回の移行の残りなら cleanup か rollback を先に）")
    if not spec.subvolume and is_subvolume_root(path):
        plan.subvolume = True
        plan.warnings.append("既にサブボリュームなので、サブボリュームのまま作り直す")
    sv = containing_subvolume(path, mounts)
    cfg = snapshot_config_for(sv, configs) if not is_subvolume_root(path) else None
    plan.snapshot = cfg.name if cfg else ""
    if cfg and not plan.subvolume and (spec.nocow_all or spec.nocow_subdirs):
        plan.warnings.append(f"snapper「{cfg.name}」の対象の中なので、NOCOW だけでは効果が薄い（--subvolume を推奨）")
    for s in spec.nocow_subdirs:
        if not os.path.isdir(path / s):
            plan.warnings.append(f"{s} が無いので NOCOW にしない（後から作られると CoW になる）")
    plan.nocow_subdirs = [s for s in spec.nocow_subdirs if os.path.isdir(path / s)]
    # 望む形（サブボリュームか・NOCOW か）に既になっていれば何もしない
    subvol_ok = not plan.subvolume or is_subvolume_root(path)
    nocow_ok = not (plan.nocow_all or plan.nocow_subdirs) or nocow_is_satisfied(path, plan.nocow_all, plan.nocow_subdirs)
    if subvol_ok and nocow_ok:
        plan.skip = "対応済み"
        return plan
    plan.stats = walk_with_status(path, str(path), mount_points={x.mount_point for x in mounts})
    if plan.stats.nested_subvolumes:
        plan.errors.append("入れ子のサブボリュームがある（コピーすると普通のディレクトリになってしまう）: " + ", ".join(plan.stats.nested_subvolumes[:5]))
    if plan.stats.unreadable:
        plan.errors.append(f"読めないファイル・ディレクトリが {plan.stats.unreadable} 件ある（root で実行する）")
    if plan.nocow_all:
        plan.nocow_bytes = plan.stats.bytes
    else:
        plan.nocow_bytes = sum(walk_tree(path / s).bytes for s in plan.nocow_subdirs)
    vfs = os.statvfs(path)
    free = vfs.f_bavail * vfs.f_frsize
    if plan.nocow_bytes > free * 0.9:
        plan.errors.append(f"空き容量が足りない（実コピー {human(plan.nocow_bytes)} / 空き {human(free)}）")
    return plan


# ---- コピー ----


def read_wchar(pid: int) -> int:
    """プロセスが write 系で書いたバイト数（/proc/<pid>/io）。"""
    with contextlib.suppress(OSError, ValueError):
        for line in Path(f"/proc/{pid}/io").read_text().splitlines():
            if line.startswith("wchar:"):
                return int(line.split()[1])
    return 0


def run_cp(args: list[str], total: int, label: str, *, reflink: bool) -> None:
    """cp を実行し、書き込み量でプログレスバーを出す（reflink は容量を書かないので経過時間だけ）。"""
    log(f"+ {shlex.join(args)}", "yellow")
    with tempfile.TemporaryFile("w+") as err:
        proc = subprocess.Popen(args, stdout=subprocess.DEVNULL, stderr=err, env=CMD_ENV)
        columns: list[Any] = [SpinnerColumn(), TextColumn("{task.description}")]
        if reflink:
            columns += [TimeElapsedColumn()]
        else:
            columns += [BarColumn(), DownloadColumn(binary_units=True), TransferSpeedColumn(), TimeRemainingColumn(), TimeElapsedColumn()]
        start = last_log = time.monotonic()
        with Progress(*columns, console=log.console, transient=False) as prog:
            task = prog.add_task(label, total=None if reflink else max(total, 1))
            while proc.poll() is None:
                done = read_wchar(proc.pid)
                prog.update(task, completed=min(done, total))
                now = time.monotonic()
                if now - last_log >= PROGRESS_LOG_INTERVAL and log.file_console:
                    log.file_console.print(f"    {label}: 経過 {now - start:.0f} 秒 / 書き込み {human(done)} / 全体 {human(total)}", markup=False)
                    last_log = now
                time.sleep(0.5)
            prog.update(task, completed=total)
        err.seek(0)
        msg = err.read().strip()
    if proc.returncode != 0:
        raise MigrationError(f"cp が失敗した（終了コード {proc.returncode}）: {msg[-2000:]}")
    log(f"  {label}: 完了（{time.monotonic() - start:.0f} 秒）")


def copy_dir_meta(src: Path, dst: Path) -> None:
    """ディレクトリの所有者・権限・拡張属性（ACL・SELinux 等）を写す。btrfs.* は写さない。"""
    s = os.lstat(src)
    with contextlib.suppress(PermissionError):
        os.chown(dst, s.st_uid, s.st_gid)
    os.chmod(dst, stat.S_IMODE(s.st_mode))
    with contextlib.suppress(OSError):
        for name in os.listxattr(src, follow_symlinks=False):
            if name.startswith("btrfs."):
                continue
            try:
                os.setxattr(dst, name, os.getxattr(src, name, follow_symlinks=False), follow_symlinks=False)
            except OSError as e:
                log(f"  拡張属性 {name} を写せない（{dst}）: {e}", "yellow")


def copy_excluding(src: Path, dst: Path, excludes: set[Path], rel: Path = Path()) -> None:
    """src の中身を dst へ reflink でコピーする。excludes（相対パス）とその下は除く。"""
    batch: list[str] = []
    descend: list[str] = []
    with os.scandir(src / rel) as it:
        for e in sorted(it, key=lambda x: x.name):
            r = rel / e.name
            if r in excludes:
                continue
            if any(r in ex.parents for ex in excludes):
                descend.append(e.name)
            else:
                batch.append(e.path)
    for i in range(0, len(batch), 500):
        chunk = batch[i : i + 500]
        run_cp(["cp", "-a", "--reflink=auto", "-t", str(dst / rel), "--", *chunk], 0, f"reflink でコピー: {src / rel}（{len(chunk)} 件）", reflink=True)
    for name in descend:
        copy_excluding(src, dst, excludes, rel / name)


def create_target(plan: Plan) -> None:
    """新しいサブボリューム（またはディレクトリ）を作り、NOCOW を付ける。"""
    if plan.subvolume:
        run(["btrfs", "subvolume", "create", str(plan.path)])
    else:
        log(f"+ mkdir {plan.path}", "yellow")
        plan.path.mkdir()
    copy_dir_meta(plan.old, plan.path)
    if plan.nocow_all:
        run(["chattr", "+C", str(plan.path)])
    for s in plan.nocow_subdirs:
        rel = Path(s)
        # 途中のディレクトリを作って属性を写し、最後のディレクトリに NOCOW を付ける
        for part in reversed([*rel.parents][:-1]):
            d = plan.path / part
            if not d.exists():
                d.mkdir()
                copy_dir_meta(plan.old / part, d)
        (plan.path / rel).mkdir()
        copy_dir_meta(plan.old / rel, plan.path / rel)
        run(["chattr", "+C", str(plan.path / rel)])


def restore_dir_times(plan: Plan) -> None:
    """作ったディレクトリの更新日時を元に合わせる（中にコピーしたことで変わるため）。"""
    dirs = [Path()]
    for s in plan.nocow_subdirs:
        dirs += [*Path(s).parents][:-1] + [Path(s)]
    for d in dirs:
        with contextlib.suppress(OSError):
            s = os.lstat(plan.old / d)
            os.utime(plan.path / d, ns=(s.st_atime_ns, s.st_mtime_ns), follow_symlinks=False)


def verify(plan: Plan, mps: set[str]) -> TreeStats:
    """コピーの結果を確かめる（数・容量・NOCOW・サブボリューム）。"""
    a = walk_with_status(plan.old, f"検証（元）{plan.old}", mount_points=mps)
    b = walk_with_status(plan.path, f"検証（新）{plan.path}", mount_points=mps)
    log(f"  元: {a.entries:,} 件 / {human(a.bytes)}　新: {b.entries:,} 件 / {human(b.bytes)}")
    if (a.entries, a.files, a.bytes) != (b.entries, b.files, b.bytes):
        raise MigrationError(f"コピーの結果が一致しない（元 {a.entries} 件 {a.bytes} B / 新 {b.entries} 件 {b.bytes} B）")
    if plan.subvolume and not is_subvolume_root(plan.path):
        raise MigrationError(f"{plan.path} がサブボリュームになっていない")
    areas = [plan.path] if plan.nocow_all else [plan.path / s for s in plan.nocow_subdirs]
    for area in areas:
        c = walk_tree(area, check_nocow=True, mount_points=mps)
        if get_nocow(area) is not True or c.not_nocow:
            raise MigrationError(f"{area} に NOCOW でないものが {c.not_nocow} 件ある")
        log(f"  {area}: NOCOW を確認（{c.files:,} ファイル）", "green")
    return b


def migrate_one(plan: Plan, mps: set[str]) -> None:
    """1か所を移す: 退避 → 作成 → コピー → 検証。"""
    log(f"==== {plan.path}: {plan.describe()} ====", "bold cyan")
    log(f"+ mv {plan.path} {plan.old}", "yellow")
    os.rename(plan.path, plan.old)
    create_target(plan)
    if plan.nocow_all:
        run_cp(["cp", "-a", "--reflink=never", f"{plan.old}/.", f"{plan.path}/"], plan.nocow_bytes, f"実コピー（NOCOW）: {plan.path}", reflink=False)
    else:
        copy_excluding(plan.old, plan.path, {Path(s) for s in plan.nocow_subdirs})
        for s in plan.nocow_subdirs:
            total = walk_tree(plan.old / s).bytes
            run_cp(["cp", "-a", "--reflink=never", f"{plan.old / s}/.", f"{plan.path / s}/"], total, f"実コピー（NOCOW）: {plan.path / s}", reflink=False)
    restore_dir_times(plan)
    verify(plan, mps)


def remove_tree(path: Path) -> None:
    """ディレクトリまたはサブボリュームを消す（root でなければ中身を消してから rmdir）。"""
    if not path.exists() and not path.is_symlink():
        return
    if is_subvolume_root(path) and os.geteuid() == 0:
        run(["btrfs", "subvolume", "delete", str(path)])
        return
    with log.console.status(f"削除中: {path}"):
        run(["rm", "-rf", "--one-file-system", "--", str(path)])
    if path.exists():  # 一般ユーザーが作ったサブボリュームは中身を消した後に rmdir できる
        os.rmdir(path)


def undo_one(path: Path) -> None:
    """1か所を元に戻す（新しい側を消し、<パス>.old を戻す）。"""
    old = old_path(path)
    if not old.exists():
        if path.exists():
            log(f"{path}: 退避する前だったので変更なし", "dim")
            return
        raise MigrationError(f"{path} も {old} も無い")
    if path.exists():
        remove_tree(path)
    log(f"+ mv {old} {path}", "yellow")
    os.rename(old, path)


# ---- サブコマンド ----


def confirm(args: argparse.Namespace, question: str) -> bool:
    """確認する（--yes なら聞かない）。"""
    if args.yes:
        return True
    if not sys.stdin.isatty():
        raise MigrationError("端末からの確認ができない。確認なしで進めるなら --yes を付ける")
    return Confirm.ask(question, console=log.console, default=False)


def specs_from_args(args: argparse.Namespace) -> tuple[list[TargetSpec], Preset | None]:
    """コマンドラインから移行の対象を決める。"""
    if args.preset:
        if args.paths or args.nocow or args.nocow_subdir or args.subvolume:
            raise MigrationError("--preset と、パス・--subvolume・--nocow・--nocow-subdir は同時に指定できない")
        preset = PRESETS[args.preset]
        specs = [t for t in preset.targets if os.path.isdir(expand(t.path))]
        for t in preset.targets:
            if t not in specs:
                log(f"{t.path} が無いのでスキップ", "dim")
        return specs, preset
    if not args.paths:
        raise MigrationError("移すディレクトリか --preset を指定する")
    if not (args.subvolume or args.nocow or args.nocow_subdir):
        raise MigrationError("--subvolume・--nocow・--nocow-subdir のどれかを指定する")
    if args.nocow and args.nocow_subdir:
        raise MigrationError("--nocow と --nocow-subdir は同時に指定できない")
    for s in args.nocow_subdir:
        if os.path.isabs(s) or ".." in Path(s).parts:
            raise MigrationError(f"--nocow-subdir は対象の中の相対パスで指定する: {s}")
    specs = [TargetSpec(p, args.subvolume, args.nocow, tuple(args.nocow_subdir)) for p in args.paths]
    return specs, None


def cmd_migrate(args: argparse.Namespace) -> int:
    """移行する。"""
    specs, preset = specs_from_args(args)
    if not specs:
        log("移す対象が無い", "yellow")
        return 0
    units = list(preset.stop_units if preset else ()) + list(args.stop)
    mounts = read_mounts()
    configs = read_snapshot_configs()
    plans = [make_plan(s, mounts, configs) for s in specs]

    t = Table(title="移行の計画" + ("（dry-run）" if args.dry_run else ""), title_justify="left")
    for col in ("対象", "操作", "件数", "容量", "実コピー", "スナップショット", "注意"):
        t.add_column(col, overflow="fold")
    for p in plans:
        notes = [Text(e, "bold red") for e in p.errors] + [Text(w, "yellow") for w in p.warnings]
        if p.skip:
            notes.insert(0, Text(p.skip, "green"))
        t.add_row(
            str(p.path), p.describe(), f"{p.stats.entries:,}" if p.stats else "", human(p.stats.bytes) if p.stats else "",
            human(p.nocow_bytes) if p.stats else "", p.snapshot or "—", Text("\n").join(notes),
        )
    log.table(t)
    if units:
        log(f"止めるサービス（動いているものだけ。終わったら逆順に起動する）: {', '.join(units)}")
    if any(p.errors for p in plans):
        log("問題があるので中止する", "bold red")
        return 1
    todo = [p for p in plans if not p.skip]
    if not todo:
        log("すべて対応済み", "green")
        return 0
    if args.dry_run:
        log("dry-run なので、ここで終わる（何も変更していない）", "green")
        return 0
    if not confirm(args, "この内容で移行しますか？（サービスを止めている間は使えなくなります）"):
        log("中止した")
        return 1

    state_path = args.state or default_state_path()
    with state_lock(state_path):
        state = State(state_path)
        for p in todo:
            if str(p.path) in state.migrations:
                raise MigrationError(f"{p.path} の移行の記録が残っている（cleanup か rollback を先に）")
        containers = docker_running_containers() if preset and preset.restore_docker else []
        if containers:
            log(f"移行前に動いているコンテナ: {', '.join(containers)}")
        started = time.monotonic()
        stopped: list[str] = []
        done: list[Plan] = []
        try:
            stop_units(units, stopped)
            # 止めた後に、まだ使っているものが無いかを確かめる
            paths = [p.path for p in todo]
            busy = processes_using(paths)
            if preset and preset.forbid_process_prefixes:
                busy += processes_named(preset.forbid_process_prefixes)
            inner = [m.mount_point for m in read_mounts() if any(is_under(m.mount_point, str(x)) and m.mount_point != str(x) for x in paths)]
            if busy or inner:
                for b in busy + [f"マウント: {m}" for m in inner]:
                    log(f"  使用中: {b}", "red")
                raise MigrationError("対象を使っているプロセスかマウントがある（止めてからやり直す）")
            mps = {m.mount_point for m in read_mounts()}
            for p in todo:
                state.migrations[str(p.path)] = {
                    "path": str(p.path), "old": str(p.old), "subvolume": p.subvolume, "nocow_all": p.nocow_all,
                    "nocow_subdirs": p.nocow_subdirs, "stopped_units": stopped, "docker_containers": containers,
                    "status": "copying", "started": dt.datetime.now().isoformat(timespec="seconds"), "log": str(log.path or ""),
                }
                state.save()
                done.append(p)
                migrate_one(p, mps)
                state.migrations[str(p.path)]["status"] = "done"
                state.migrations[str(p.path)]["finished"] = dt.datetime.now().isoformat(timespec="seconds")
                state.save()
        except (MigrationError, OSError, KeyboardInterrupt) as e:
            log(f"失敗: {e}", "bold red")
            if done:
                log("元に戻します", "bold red")
                for p in reversed(done):
                    try:
                        undo_one(p.path)
                        state.migrations.pop(str(p.path), None)
                    except (MigrationError, OSError) as e2:
                        log(f"{p.path} を戻せなかった: {e2}（手で {p.old} を {p.path} に戻す）", "bold red")
                state.save()
            start_units(stopped)
            restore_docker_containers(containers)
            return 1
        start_units(stopped)
        restore_docker_containers(containers)
    log(f"完了（停止していた時間: {time.monotonic() - started:.0f} 秒）", "bold green")
    log(f"動作を確認したら `btrfs-nocow cleanup` で {', '.join(str(p.old) for p in todo)} を削除する（戻すなら `btrfs-nocow rollback`）")
    log("古いスナップショットが参照している分は、cleanup の後も保持期限が切れるまで容量が戻らない", "dim")
    return 0


def select_records(args: argparse.Namespace, state: State) -> list[dict[str, Any]]:
    """rollback / cleanup の対象の記録。"""
    recs = state.migrations
    if args.paths:
        sel = []
        for p in args.paths:
            key = str(expand(p))
            if key not in recs:
                raise MigrationError(f"{key} の移行の記録が無い（{state.path}）")
            sel.append(recs[key])
        return sel
    return list(recs.values())


def cmd_rollback(args: argparse.Namespace) -> int:
    """移行の前に戻す。"""
    state_path = args.state or default_state_path()
    with state_lock(state_path):
        state = State(state_path)
        recs = select_records(args, state)
        if not recs:
            log(f"移行の記録が無い（{state.path}）")
            return 0
        for r in recs:
            log(f"{r['path']} を {r['old']} の内容に戻す（移行の後に書き込まれたデータは失われる）", "yellow")
        if args.dry_run or not confirm(args, "元に戻しますか？"):
            return 0
        units = list(dict.fromkeys(u for r in recs for u in r.get("stopped_units", [])))
        containers = list(dict.fromkeys(c for r in recs for c in r.get("docker_containers", [])))
        stopped: list[str] = []
        try:
            stop_units(units, stopped)
            busy = processes_using([Path(r["path"]) for r in recs])
            if busy:
                for b in busy:
                    log(f"  使用中: {b}", "red")
                raise MigrationError("対象を使っているプロセスがある")
            for r in recs:
                undo_one(Path(r["path"]))
                state.migrations.pop(r["path"], None)
                state.save()
        finally:
            start_units(stopped)
            restore_docker_containers(containers)
    log("元に戻した", "bold green")
    return 0


def cmd_cleanup(args: argparse.Namespace) -> int:
    """退避した <パス>.old を消す。"""
    state_path = args.state or default_state_path()
    with state_lock(state_path):
        state = State(state_path)
        recs = select_records(args, state)
        if not recs:
            log(f"移行の記録が無い（{state.path}）")
            return 0
        for r in recs:
            if r.get("status") != "done":
                raise MigrationError(f"{r['path']} の移行が完了していない（status={r.get('status')}）。rollback する")
            if r.get("subvolume") and not is_subvolume_root(Path(r["path"])):
                raise MigrationError(f"{r['path']} がサブボリュームになっていない")
            log(f"削除する: {r['old']}")
        if args.dry_run or not confirm(args, "削除しますか？（元には戻せなくなります）"):
            return 0
        for r in recs:
            remove_tree(Path(r["old"]))
            state.migrations.pop(r["path"], None)
            state.save()
    log("削除した（古いスナップショットが参照している分は、保持期限が切れるまで容量が戻らない）", "bold green")
    return 0


